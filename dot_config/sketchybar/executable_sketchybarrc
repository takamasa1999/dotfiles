# SketchyBar config: AeroSpace workspaces with app name abbreviations.
# All items live on the LEFT side of the bar to stay clear of the
# MacBook Air notch. No clock / battery / volume etc.

PLUGIN_DIR="$CONFIG_DIR/plugins"

##### Bar Appearance #####
# https://felixkratz.github.io/SketchyBar/config/bar
sketchybar --bar \
  position=top \
  height=32 \
  blur_radius=30 \
  color=0x40000000 \
  padding_left=10 \
  padding_right=10

##### Defaults #####
default=(
  padding_left=4
  padding_right=4
  icon.font="Hack Nerd Font:Bold:13.0"
  label.font="Hack Nerd Font:Regular:12.0"
  icon.color=0xffffffff
  label.color=0xffffffff
)
sketchybar --default "${default[@]}"

##### AeroSpace Workspaces #####
# Custom event triggered by aerospace's exec-on-workspace-change.
sketchybar --add event aerospace_workspace_change

for sid in $(aerospace list-workspaces --all); do
  space=(
    icon="$sid"
    icon.padding_left=8
    icon.padding_right=2
    label.padding_left=2
    label.padding_right=8
    background.color=0x40ffffff
    background.corner_radius=6
    background.height=24
    background.drawing=off
    script="$PLUGIN_DIR/aerospace.sh"
    click_script="aerospace workspace $sid"
  )
  sketchybar --add item space."$sid" left \
             --set space."$sid" "${space[@]}" \
             --subscribe space."$sid" aerospace_workspace_change \
                                      front_app_switched \
                                      space_windows_change
done

##### Initialize #####
sketchybar --update
