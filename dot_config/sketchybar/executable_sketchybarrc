# SketchyBar config: AeroSpace workspaces with app names.
# Items flow on the left and, when they would reach the notch, an
# invisible spacer (notch_gap) pads them past it so nothing is hidden
# behind the MacBook notch. No clock / battery / volume etc.

PLUGIN_DIR="$CONFIG_DIR/plugins"

##### Bar Appearance #####
# https://felixkratz.github.io/SketchyBar/config/bar
sketchybar --bar \
  position=top \
  display=main \
  height=32 \
  blur_radius=30 \
  color=0x40000000 \
  padding_left=10 \
  padding_right=10

##### Defaults #####
default=(
  padding_left=4
  padding_right=4
  icon.font="Hack Nerd Font:Bold:13.0"
  label.font="Hack Nerd Font:Regular:12.0"
  icon.color=0xffffffff
  label.color=0xffffffff
)
sketchybar --default "${default[@]}"

##### AeroSpace Workspaces #####
# Custom event triggered by aerospace's exec-on-workspace-change.
sketchybar --add event aerospace_workspace_change
sketchybar --add event aerospace_monitor_change

for sid in $(aerospace list-workspaces --all); do
  space=(
    icon="#$sid"
    icon.padding_left=8
    icon.padding_right=2
    label.padding_left=2
    label.padding_right=8
    background.color=0x40ffffff
    background.corner_radius=6
    background.height=24
    background.drawing=off
    click_script="aerospace workspace $sid"
  )
  sketchybar --add item space."$sid" left \
             --set space."$sid" "${space[@]}"
done

##### Notch Spacer #####
# Invisible fixed-width item that workspaces.sh moves in front of the
# first item that would collide with the notch.
sketchybar --add item notch_gap left \
           --set notch_gap \
                 drawing=off \
                 padding_left=0 \
                 padding_right=0 \
                 icon.drawing=off \
                 label.drawing=off \
                 background.drawing=off

##### Observer #####
# Hidden item whose script updates all workspace items and places the
# notch spacer. Reacts to workspace / app changes.
sketchybar --add item workspace_observer left \
           --set workspace_observer \
                 drawing=off \
                 updates=on \
                 script="$PLUGIN_DIR/workspaces.sh" \
           --subscribe workspace_observer aerospace_workspace_change \
                                          aerospace_monitor_change \
                                          front_app_switched \
                                          space_windows_change

##### Initialize #####
sketchybar --update
